{
  "name": "@iso4/core",
  "version": "0.0.0",
  "type": "module",
  "description": "Shared types for the iso4 runtime ecosystem (@iso4/dynamic, @iso4/static, @iso4/fetch)",
  "keywords": [
    "iso4",
    "sandbox",
    "v8",
    "types"
  ],
  "license": "MIT",
  "author": "schplitt",
  "homepage": "https://github.com/schplitt/iso4/tree/main/packages/iso4-core#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/schplitt/iso4.git",
    "directory": "packages/iso4-core"
  },
  "bugs": {
    "url": "https://github.com/schplitt/iso4/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
