{
  "name": "@iso4/static",
  "version": "0.0.0",
  "type": "module",
  "description": "High-throughput in-process V8 isolate runtime for static (precompiled) JavaScript. napi-rs backend, requires container isolation.",
  "keywords": [
    "sandbox",
    "isolate",
    "v8",
    "napi",
    "analytics",
    "performance"
  ],
  "license": "MIT",
  "author": "schplitt",
  "homepage": "https://github.com/schplitt/iso4/tree/main/packages/iso4-static#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/schplitt/iso4.git",
    "directory": "packages/iso4-static"
  },
  "bugs": {
    "url": "https://github.com/schplitt/iso4/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@iso4/core": "workspace:*"
  },
  "optionalDependencies": {
    "@iso4/static-darwin-arm64": "workspace:*",
    "@iso4/static-darwin-x64": "workspace:*",
    "@iso4/static-linux-x64-gnu": "workspace:*",
    "@iso4/static-linux-arm64-gnu": "workspace:*"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@schplitt/eslint-config": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
