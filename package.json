{
  "name": "iso4-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "description": "iso4 \u2014 fast, sandboxed V8 isolate runtime with permission-controlled fetch and pluggable modules",
  "license": "MIT",
  "author": "schplitt",
  "homepage": "https://github.com/schplitt/iso4#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/schplitt/iso4.git"
  },
  "bugs": {
    "url": "https://github.com/schplitt/iso4/issues"
  },
  "scripts": {
    "build": "pnpm build:native && pnpm -r --filter=\"./packages/*\" build",
    "build:dev": "pnpm build:native:dev && pnpm -r --filter=\"./packages/*\" build",
    "test": "pnpm -r --filter=\"./packages/*\" test",
    "test:run": "pnpm test:native && pnpm -r --filter=\"./packages/*\" test:run",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "pnpm -r --filter=\"./packages/*\" typecheck",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "changeset:publish": "changeset publish",
    "prerelease": "pnpm lint && pnpm typecheck && pnpm build && pnpm test:run",
    "build:native": "node scripts/build-native.ts --release",
    "build:native:dev": "node scripts/build-native.ts",
    "check:native": "cargo check --manifest-path native/v8-runtime/Cargo.toml",
    "test:native": "cargo test --manifest-path native/v8-runtime/Cargo.toml",
    "lint:native": "cargo clippy --manifest-path native/v8-runtime/Cargo.toml -- -D warnings",
    "fmt:native": "cargo fmt --manifest-path native/v8-runtime/Cargo.toml"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@schplitt/eslint-config": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
